---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Blox Fruits Value List & Trade Calculator',
  description =
    'Blox Fruits value list and trade calculator. Check fruit values, demand, and compare trades before you accept.',
} = Astro.props

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isHome = path === '/'

const topCta =
  path === '/values' || path.startsWith('/values/')
    ? { href: '/calculator', label: 'Open Calculator' }
    : path === '/calculator'
      ? { href: '/values', label: 'Open Values' }
      : { href: '/values', label: 'Open Values' }

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BloxFruit.fun',
  alternateName: ['Blox Fruits Values', 'Blox Fruits Value List'],
  url: 'https://bloxfruit.fun/',
  description:
    'Blox Fruits value list and trade calculator — fruits, demand, and fair trade compare.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://bloxfruit.fun/values/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Blox Fruits Values" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Blox Fruits Values" />
    <meta
      property="og:image"
      content={Astro.site ? new URL('/og.png', Astro.site).toString() : '/og.png'}
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BloxFruit.fun — Blox Fruits value list and trade calculator" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={Astro.site ? new URL('/og.png', Astro.site).toString() : '/og.png'}
    />
    {
      isHome && (
        <>
          <link rel="preload" href="/items/dragon-east.jpg" as="image" fetchpriority="high" />
          <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
        </>
      )
    }
  </head>
  <body class={isHome ? 'is-home' : undefined}>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <img class="brand-fruit" src="/brand-dragon.png" alt="" width="28" height="28" />
          <span class="brand-name">BloxFruit<span>.fun</span></span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a
            href="/values"
            aria-current={path === '/values' || path.startsWith('/values/') ? 'page' : undefined}
            >Value List</a
          >
          <a href="/calculator" aria-current={path === '/calculator' ? 'page' : undefined}
            >Calculator</a
          >
        </nav>
        <a class="top-cta" href={topCta.href}>{topCta.label}</a>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <a class="footer-brand" href="/">
            <img src="/brand-dragon.png" alt="" width="22" height="22" loading="lazy" />
            <span>BloxFruit<span>.fun</span></span>
          </a>
          <p>
            Roblox® and Blox Fruits are trademarks of their respective owners. bloxfruit.fun is a
            3rd party site and is not affiliated with or endorsed by Roblox or the Blox Fruits
            developers.
          </p>
          <p class="footer-copy">© 2026</p>
        </div>
      </footer>
    </div>
  </body>
</html>
